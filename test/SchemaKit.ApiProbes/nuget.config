<?xml version="1.0" encoding="utf-8"?>
<!--
    The probes compile with the exact Roslyn the .NET 11 rc.2 SDK ships (5.12.0-1.26504.105). It is
    published on the dotnet-tools feed only; nuget.org's newest, 5.9.0, knows `closed` but not
    exhaustiveness across assemblies, so a consumer's complete switch over PgIndex warned CS8509
    there and compiles clean with the SDK. Source mapping keeps every other package on nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="dotnet-tools">
      <package pattern="Microsoft.CodeAnalysis.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
