<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- EF Core and its providers at the floor src/ declares, every one of them: a provider
             pinned higher pulls EF Core up behind it, and the suite then tests a mix no consumer
             has. test/Directory.Build.targets floats them to another patch (#133). -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
        <!-- Design-time services (snapshot code generation) as a regular library reference:
             the snapshot round-trip tests drive the real `migrations add` pipeline in-process. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
            <PrivateAssets>none</PrivateAssets>
            <IncludeAssets>all</IncludeAssets>
        </PackageReference>
        <!-- EF Core Sqlite 10.0.0 brings SQLitePCLRaw 2.1.11, whose native SQLite 3.49.1 has
             CVE-2025-6965 (#202). 2.1.12 and later ship SQLite 3.53. Only the native library
             moves: Microsoft.Data.Sqlite stays at the floor, and no package under src/ references
             SQLite. test/Directory.Build.targets drops the pin when EF Core floats. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
        <PackageReference Include="MSTest" Version="4.5.1" />
        <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
        <!-- Generated model snapshots reference internal test context types via [DbContext(typeof(...))]. -->
        <InternalsVisibleTo Include="SnapshotRoundTrip.Generated"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\EFCore.ComplexIndexes\EFCore.ComplexIndexes.csproj" />
      <ProjectReference Include="..\..\src\EFCore.ComplexIndexes.PostgreSQL\EFCore.ComplexIndexes.PostgreSQL.csproj" />
      <ProjectReference Include="..\..\src\EFCore.ComplexIndexes.SqlServer\EFCore.ComplexIndexes.SqlServer.csproj" />
    </ItemGroup>

</Project>
