<Project>
    <!--
        Shipping projects only: MSBuild imports the nearest Directory.Build.targets above a project,
        so this one reaches src/ and nothing else. A Directory.Build.targets added at the root later
        does not reach src/ unless this file imports it.
    -->

    <!--
        Release notes are the version's section of the package's own CHANGELOG.md.

        nuget.org's Release Notes tab and Visual Studio's Updates tab both show the nuspec's
        releaseNotes. nuget.org renders the field as plain text (measured 2026-10-20 on bunit 2.12.5
        and Bogus 35.6.5, and in NuGetGallery's HtmlExtensions.PreFormattedText): HTML-encoded, line
        breaks kept, bare http(s) URLs turned into links that stop before a parenthesis, and Markdown
        shown literally. So a line keeps reading as a line, the section is written plain:
        [text](url) becomes "text (url)", and backticks, bold markers and the "### " of a section
        heading are dropped. One footer line links the full changelog at the version's tag.

        Fail closed: no changelog, no section for $(PackageVersion), an empty section, or notes over
        nuget.org's 35,000-character limit each fail the pack, naming the file. A package with
        nothing in a version says "No change in this package.", so the section always exists.

        GenerateNuspec is incremental, and the changelog is none of its inputs: without adding it,
        a changelog edit followed by a second pack keeps the first pack's notes.

        ReleaseNotesChangelog is overridable so PackagingConventionTests can point the target at a
        seeded changelog and watch it fail.
    -->
    <PropertyGroup>
        <ReleaseNotesChangelog Condition="'$(ReleaseNotesChangelog)' == ''">$(MSBuildProjectDirectory)/CHANGELOG.md</ReleaseNotesChangelog>
    </PropertyGroup>

    <!--
        A package links the docs as they were when it was built (#151).

        The changelogs and the packed READMEs link this repository at blob/main, which
        DocumentationLinkTests resolves against the checkout. A package can never change once
        published, while main moves on: after the v5.5.0 tag it is the SchemaKit line and reshapes
        docs/. So the release notes and the packed README link the tag of the version being packed
        instead, the same tag the notes' footer links. On the tagged commit the checkout is the
        tag's tree, so the link test that passed there proves the frozen links resolve.

        A pack of an untagged version (a PR's pack job, the smoke test) links a tag that does not
        exist yet. Nothing reads those links, and a package built from the tag gets them right.
        The release job in release.yml freezes the GitHub release's notes the same way.
    -->
    <Target Name="_ComputeFrozenLinks">
        <Error Condition="'$(RepositoryUrl)' == ''"
               Text="Cannot freeze the documentation links of $(PackageId): RepositoryUrl is not set." />

        <PropertyGroup>
            <_FrozenLinkPattern>$([System.Text.RegularExpressions.Regex]::Escape($(RepositoryUrl)))/(blob|tree)/main/</_FrozenLinkPattern>
            <_FrozenLinkReplacement>$(RepositoryUrl)/$1/v$(PackageVersion)/</_FrozenLinkReplacement>
        </PropertyGroup>
    </Target>

    <!--
        The README is packed from a rewritten copy under obj/, swapped for the original in the pack's
        file list after NuGet has collected it. The list is NuGet's own item, so a rename on its side
        would leave the original in place; the pack fails instead when no packed file is the README,
        and PackagingConventionTests compares the packed README with its source.
    -->
    <Target Name="FreezePackageReadmeLinks"
            BeforeTargets="GenerateNuspec"
            DependsOnTargets="_ComputeFrozenLinks"
            Condition="'$(IsPackable)' == 'true' and '$(PackageReadmeFile)' != ''">
        <ItemGroup>
            <_ReadmeToFreeze Include="@(_PackageFiles)" Condition="'%(Filename)%(Extension)' == '$(PackageReadmeFile)'" />
        </ItemGroup>

        <Error Condition="'@(_ReadmeToFreeze->Count())' != '1'"
               Text="Cannot freeze the documentation links of $(PackageId): expected one packed file named $(PackageReadmeFile), found @(_ReadmeToFreeze->Count())." />

        <PropertyGroup>
            <_FrozenReadme>$(IntermediateOutputPath)frozen-readme/$(PackageReadmeFile)</_FrozenReadme>
            <_FrozenReadmeText>$([System.IO.File]::ReadAllText(%(_ReadmeToFreeze.FullPath)))</_FrozenReadmeText>
            <_FrozenReadmeText>$([System.Text.RegularExpressions.Regex]::Replace($(_FrozenReadmeText), $(_FrozenLinkPattern), $(_FrozenLinkReplacement)))</_FrozenReadmeText>
        </PropertyGroup>

        <WriteLinesToFile File="$(_FrozenReadme)" Lines="$(_FrozenReadmeText)" Overwrite="true" WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <_PackageFiles Remove="@(_ReadmeToFreeze)" />
            <_PackageFiles Include="@(_ReadmeToFreeze->'$(_FrozenReadme)')" />
            <NuGetPackInput Include="$(_FrozenReadme)" />
            <_ReadmeToFreeze Remove="@(_ReadmeToFreeze)" />
        </ItemGroup>
    </Target>

    <!--
        A satellite depends on exactly the core it was built with (#169).

        A ProjectReference packs as a dependency on ">= the referenced version", and the satellites
        bind to the core's internals through InternalsVisibleTo, so any later core would satisfy
        them while breaking them. Up to 5.4.1 that let a consumer who updated only a direct core
        reference run a 5.4.1 satellite against core 5.5.0 without a warning. The three packages are
        released together under one version, patches on release/5.x included, so an exact pin never
        refuses a pair that was released. A range up to the next minor would admit core 5.5.1 under
        satellite 5.5.0, which is the pair this pin exists to keep out.

        NuGet has no metadata on a ProjectReference for the range, so this rewrites the version the
        pack task reads from its own item. The pack fails when that item does not hold one entry
        per ProjectReference, which is how a rename on NuGet's side would show; otherwise the
        dependency would quietly go back to ">=". PackagingConventionTests reads the packed nuspec.
    -->
    <Target Name="PinProjectReferenceDependencies"
            BeforeTargets="GenerateNuspec"
            Condition="'$(IsPackable)' == 'true'">
        <Error Condition="'@(ProjectReference->Count())' != '@(_ProjectReferencesWithVersions->Count())'"
               Text="Cannot pin the dependencies of $(PackageId) on the packages it references: expected one versioned entry per ProjectReference (@(ProjectReference->Count())), found @(_ProjectReferencesWithVersions->Count())." />

        <ItemGroup>
            <_ProjectReferencesWithVersions>
                <ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
            </_ProjectReferencesWithVersions>
        </ItemGroup>
    </Target>

    <Target Name="SetPackageReleaseNotesFromChangelog"
            BeforeTargets="GenerateNuspec"
            DependsOnTargets="_ComputeFrozenLinks"
            Condition="'$(IsPackable)' == 'true'">
        <Error Condition="!Exists('$(ReleaseNotesChangelog)')"
               Text="Cannot set the release notes of $(PackageId): $(ReleaseNotesChangelog) does not exist." />

        <PropertyGroup>
            <_ReleaseNotesVersion>$([System.Text.RegularExpressions.Regex]::Escape($(PackageVersion)))</_ReleaseNotesVersion>
            <_ReleaseNotes>$([System.IO.File]::ReadAllText($(ReleaseNotesChangelog)))</_ReleaseNotes>
            <_ReleaseNotes>$([System.Text.RegularExpressions.Regex]::Replace($(_ReleaseNotes), '\r', ''))</_ReleaseNotes>
            <_ReleaseNotes>$([System.Text.RegularExpressions.Regex]::Match($(_ReleaseNotes), '(?ms)(?&lt;=^## \[$(_ReleaseNotesVersion)\][^\n]*\n).*?(?=^## |\z)').Value.Trim())</_ReleaseNotes>
        </PropertyGroup>

        <Error Condition="'$(_ReleaseNotes)' == ''"
               Text="Cannot set the release notes of $(PackageId): $(ReleaseNotesChangelog) has no '## [$(PackageVersion)]' section, or it is empty. A version with nothing for this package says 'No change in this package.'" />

        <PropertyGroup>
            <_ReleaseNotes>$([System.Text.RegularExpressions.Regex]::Replace($(_ReleaseNotes), $(_FrozenLinkPattern), $(_FrozenLinkReplacement)))</_ReleaseNotes>
            <_ReleaseNotes>$([System.Text.RegularExpressions.Regex]::Replace($(_ReleaseNotes), '\[([^\]\n]+)\]\((https?://[^)\s]+)\)', '$1 ($2)'))</_ReleaseNotes>
            <_ReleaseNotes>$([System.Text.RegularExpressions.Regex]::Replace($(_ReleaseNotes), '\x60|\*\*', ''))</_ReleaseNotes>
            <_ReleaseNotes>$([System.Text.RegularExpressions.Regex]::Replace($(_ReleaseNotes), '(?m)^### ', ''))</_ReleaseNotes>
            <PackageReleaseNotes>$(_ReleaseNotes)%0A%0AFull changelog: $(RepositoryUrl)/blob/v$(PackageVersion)/src/$(MSBuildProjectName)/CHANGELOG.md</PackageReleaseNotes>
        </PropertyGroup>

        <Error Condition="$(PackageReleaseNotes.Length) &gt; 35000"
               Text="Cannot set the release notes of $(PackageId): the '## [$(PackageVersion)]' section of $(ReleaseNotesChangelog) renders to $(PackageReleaseNotes.Length) characters, over nuget.org's limit of 35,000." />

        <ItemGroup>
            <NuGetPackInput Include="$(ReleaseNotesChangelog)" />
        </ItemGroup>
    </Target>
</Project>
